<script>
(function(){

    var maxAttempts = 30;
    var attempt = 0;

    function aplicarRangos(){
        var valEl = document.getElementById('valorAutorregulacion');
        if(!valEl || valEl.textContent === '--' || attempt >= maxAttempts){
            attempt++;
            if(attempt < maxAttempts){
                setTimeout(aplicarRangos, 150);
            }
            return;
        }

        function colorSegun(score, v, a){
            if(score <= v) return '#39B54A';
            if(score <= a) return '#F59E0B';
            return '#EF4444';
        }

        function activarLabel(containerId, score, v, a){
            var container = document.getElementById(containerId);
            if(!container) return;
            var labels = container.querySelectorAll('.rango-label');
            var rango = score <= v ? 'bajo' : (score <= a ? 'moderado' : 'alto');
            labels.forEach(function(lb){
                lb.classList.toggle('activo', lb.getAttribute('data-rango') === rango);
            });
        }

        function procesarBarra(scoreId, barraId, valorId, maxScore, verde, amarillo, rangosId, isTotal){
            var scoreText = document.getElementById(scoreId);
            var barra = document.getElementById(barraId);
            var valorSpan = document.getElementById(valorId);
            if(!scoreText || !barra) return;
            var score = parseInt(scoreText.textContent, 10);
            if(isNaN(score)) return;
            var pct = (score / maxScore) * 100;
            if(isTotal){
                barra.style.width = Math.min(pct, 100) + '%';
            }
            barra.style.background = colorSegun(score, verde, amarillo);
            if(valorSpan){
                valorSpan.textContent = score + '/' + maxScore;
            }
            activarLabel(rangosId, score, verde, amarillo);
        }

        procesarBarra('puntajeAutorregulacion', 'barraAutorregulacion', 'valorAutorregulacion', 45, 20, 33, 'rangosAutorregulacion', false);
        procesarBarra('puntajePostergacion', 'barraPostergacion', 'valorPostergacion', 15, 6, 11, 'rangosPostergacion', false);
        procesarBarra('puntajeTotal', 'barraTotal', 'valorTotal', 60, 27, 43, 'rangosTotal', true);

        function setInterpretacion(){
            var nivelEl = document.getElementById('nivelProcrastinacion');
            var textoEl = document.getElementById('textoInterpretacionNivel');
            if(!nivelEl || !textoEl) return;
            var nivel = nivelEl.textContent.trim();
            var textos = {
                'Bajo': 'Presentas un nivel bajo de procrastinación académica. Esto indica que generalmente organizas tus actividades y cumples con tus responsabilidades escolares.',
                'Moderado': 'Presentas un nivel moderado de procrastinación académica. Esto indica que a veces retrasas actividades escolares y podrías mejorar tu organización del tiempo.',
                'Alto': 'Presentas un nivel alto de procrastinación académica. Esto indica una mayor tendencia a retrasar actividades y dificultades para mantener hábitos de estudio constantes.'
            };
            textoEl.textContent = textos[nivel] || '';
        }

        function setPorcentajes(){
            function pct(scoreId, pctId, max){
                var el = document.getElementById(scoreId);
                var pctEl = document.getElementById(pctId);
                if(!el || !pctEl) return;
                var score = parseInt(el.textContent, 10);
                if(isNaN(score)) return;
                pctEl.textContent = Math.round((score / max) * 100) + '% del máximo';
            }
            pct('puntajeAutorregulacion', 'porcentajeAuto', 45);
            pct('puntajePostergacion', 'porcentajePost', 15);
            pct('puntajeTotal', 'porcentajeTotal', 60);
        }

        setInterpretacion();
        setPorcentajes();
    }

    aplicarRangos();

})();
</script>

<%- include('partials/modalPerfil') %>

<script src="/js/perfil.js"></script>

</body>
</html>
